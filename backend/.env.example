# -- Starbit Engine · Backend Config -----------------------------
# Copy this file to .env and fill in real values before running.

# --- LLM ---
# Groq has a genuinely free API tier (no credit card required).
# 1. Go to https://console.groq.com and sign in
# 2. Click "API Keys" in the left sidebar -> "Create API Key"
# 3. Paste it below
GROQ_API_KEY=gsk_your-key-here
MODEL_NAME=openai/gpt-oss-120b

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Set to "true" to bypass real Google OAuth during local development
MOCK_AUTH=true

# --- Session security ---
SESSION_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# --- App limits ---
MAX_QUESTIONS_PER_SESSION=5
MAX_UPLOAD_SIZE_MB=25
MAX_SELF_CORRECTION_RETRIES=3

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5500
